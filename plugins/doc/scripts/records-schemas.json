{
  "decision": {
    "$defs": {
      "DecisionOption": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "pros": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Pros",
            "type": "array"
          },
          "cons": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Cons",
            "type": "array"
          }
        },
        "required": [
          "name",
          "pros",
          "cons"
        ],
        "title": "DecisionOption",
        "type": "object"
      },
      "EventRef": {
        "additionalProperties": false,
        "properties": {
          "system": {
            "description": "Plugin that wrote the record",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "System",
            "type": "string"
          },
          "event_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Event Id",
            "type": "string"
          }
        },
        "required": [
          "system",
          "event_id"
        ],
        "title": "EventRef",
        "type": "object"
      },
      "EvidenceInput": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Workspace-relative file (hashed)",
            "title": "Path"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Standard, datasheet or law cited when there is no file",
            "title": "Reference"
          }
        },
        "title": "EvidenceInput",
        "type": "object"
      },
      "InsightRef": {
        "additionalProperties": false,
        "properties": {
          "system": {
            "description": "Plugin that wrote the record",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "System",
            "type": "string"
          },
          "event_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Event Id",
            "type": "string"
          },
          "insight_id": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "Insight Id",
            "type": "string"
          }
        },
        "required": [
          "system",
          "event_id",
          "insight_id"
        ],
        "title": "InsightRef",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "Stable decision id, e.g. 'readme-quick-start'",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "title": "Id",
        "type": "string"
      },
      "stage": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "title": "Stage",
        "type": "string"
      },
      "question": {
        "minLength": 10,
        "title": "Question",
        "type": "string"
      },
      "principles": {
        "description": "First principles, physical laws or standards the choice rests on",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Principles",
        "type": "array"
      },
      "options": {
        "items": {
          "$ref": "#/$defs/DecisionOption"
        },
        "minItems": 2,
        "title": "Options",
        "type": "array"
      },
      "chosen": {
        "minLength": 1,
        "title": "Chosen",
        "type": "string"
      },
      "rationale": {
        "minLength": 200,
        "title": "Rationale",
        "type": "string"
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/EvidenceInput"
        },
        "minItems": 1,
        "title": "Evidence",
        "type": "array"
      },
      "assumptions": {
        "items": {
          "type": "string"
        },
        "title": "Assumptions",
        "type": "array"
      },
      "unknowns": {
        "items": {
          "type": "string"
        },
        "title": "Unknowns",
        "type": "array"
      },
      "risks": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Risks",
        "type": "array"
      },
      "revisit_when": {
        "minLength": 1,
        "title": "Revisit When",
        "type": "string"
      },
      "decided_by": {
        "default": "agent",
        "enum": [
          "agent",
          "user"
        ],
        "title": "Decided By",
        "type": "string"
      },
      "impression_refs": {
        "description": "Impressions (any plugin) behind it",
        "items": {
          "$ref": "#/$defs/EventRef"
        },
        "title": "Impression Refs",
        "type": "array"
      },
      "insight_refs": {
        "items": {
          "$ref": "#/$defs/InsightRef"
        },
        "title": "Insight Refs",
        "type": "array"
      }
    },
    "required": [
      "id",
      "stage",
      "question",
      "principles",
      "options",
      "chosen",
      "rationale",
      "evidence",
      "risks",
      "revisit_when"
    ],
    "title": "DecisionInput",
    "type": "object"
  },
  "impression": {
    "$defs": {
      "Claim": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "minLength": 8,
            "title": "Text",
            "type": "string"
          },
          "anchor": {
            "description": "Exact token from the artifact (part number, net, cavity, label)",
            "minLength": 2,
            "title": "Anchor",
            "type": "string"
          },
          "artifact": {
            "description": "Workspace-relative file the claim reads",
            "minLength": 1,
            "title": "Artifact",
            "type": "string"
          }
        },
        "required": [
          "text",
          "anchor",
          "artifact"
        ],
        "title": "Claim",
        "type": "object"
      },
      "Concern": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "Id",
            "type": "string"
          },
          "text": {
            "minLength": 8,
            "title": "Text",
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ],
            "title": "Severity",
            "type": "string"
          },
          "about": {
            "description": "Plugin that owns it, or 'self'",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "About",
            "type": "string"
          },
          "anchor": {
            "anyOf": [
              {
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Anchor"
          }
        },
        "required": [
          "id",
          "text",
          "severity",
          "about"
        ],
        "title": "Concern",
        "type": "object"
      },
      "Facets": {
        "additionalProperties": false,
        "properties": {
          "observed": {
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "title": "Observed",
            "type": "array"
          },
          "works": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Works",
            "type": "array"
          },
          "concerns": {
            "items": {
              "$ref": "#/$defs/Concern"
            },
            "title": "Concerns",
            "type": "array"
          },
          "no_concerns_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "No Concerns Reason"
          },
          "feelings": {
            "$ref": "#/$defs/Feelings"
          },
          "next_actions": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Next Actions",
            "type": "array"
          }
        },
        "required": [
          "observed",
          "works",
          "feelings",
          "next_actions"
        ],
        "title": "Facets",
        "type": "object"
      },
      "Feelings": {
        "additionalProperties": false,
        "properties": {
          "maker": {
            "minLength": 8,
            "title": "Maker",
            "type": "string"
          },
          "user": {
            "minLength": 8,
            "title": "User",
            "type": "string"
          }
        },
        "required": [
          "maker",
          "user"
        ],
        "title": "Feelings",
        "type": "object"
      },
      "Insight": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "Id",
            "type": "string"
          },
          "hypothesis": {
            "minLength": 20,
            "title": "Hypothesis",
            "type": "string"
          },
          "proposed_change": {
            "title": "Proposed Change",
            "type": "string"
          },
          "expected_effect": {
            "title": "Expected Effect",
            "type": "string"
          },
          "test": {
            "description": "How to check it, ideally a deterministic gate",
            "title": "Test",
            "type": "string"
          },
          "target": {
            "description": "Plugin that would change",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "Target",
            "type": "string"
          },
          "revisits": {
            "anyOf": [

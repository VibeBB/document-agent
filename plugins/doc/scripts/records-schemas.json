      "claims": {
        "items": {
          "$ref": "#/$defs/Claim"
        },
        "title": "Claims",
        "type": "array"
      },
      "insights": {
        "items": {
          "$ref": "#/$defs/Insight"
        },
        "title": "Insights",
        "type": "array"
      },
      "upstream": {
        "items": {
          "$ref": "#/$defs/Upstream"
        },
        "title": "Upstream",
        "type": "array"
      },
      "confidence": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Confidence",
        "type": "string"
      },
      "unknowns": {
        "items": {
          "type": "string"
        },
        "title": "Unknowns",
        "type": "array"
      },
      "delta": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "What is new when an earlier impression reads similarly",
        "title": "Delta"
      },
      "stage": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "title": "Stage",
        "type": "string"
      },
      "artifacts": {
        "description": "Workspace-relative files or directories the stage produced",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Artifacts",
        "type": "array"
      }
    },
    "required": [
      "impression",
      "facets",
      "claims",
      "confidence",
      "stage",
      "artifacts"
    ],
    "title": "StageImpressionInput",
    "type": "object"

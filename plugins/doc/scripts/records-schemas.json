        "type": "object"
      },
      "InsightRef": {
        "additionalProperties": false,
        "properties": {
          "system": {
            "description": "Plugin that wrote the record",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "System",
            "type": "string"
          },
          "event_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Event Id",
            "type": "string"
          },
          "insight_id": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "Insight Id",
            "type": "string"
          }
        },
        "required": [
          "system",
          "event_id",
          "insight_id"
        ],
        "title": "InsightRef",
        "type": "object"
      },
      "Upstream": {
        "additionalProperties": false,
        "properties": {
          "system": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "System",
            "type": "string"
          },
          "event_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Event Id",
            "type": "string"
          },
          "disposition": {
            "enum": [
              "adopted",
              "deferred",
              "disputed",
              "noted"
            ],
            "title": "Disposition",
            "type": "string"
          },
          "effect": {
            "minLength": 40,
            "title": "Effect",
            "type": "string"
          },
          "concern_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Concern Ids"
          }
        },
        "required": [
          "system",
          "event_id",
          "disposition",
          "effect"
        ],
        "title": "Upstream",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "impression": {
        "title": "Impression",
        "type": "string"
      },
      "facets": {
        "$ref": "#/$defs/Facets"

      "upstream": {
        "items": {
          "$ref": "#/$defs/Upstream"
        },
        "title": "Upstream",
        "type": "array"
      },
      "confidence": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Confidence",
        "type": "string"
      },
      "unknowns": {
        "items": {
          "type": "string"
        },
        "title": "Unknowns",
        "type": "array"
      },
      "delta": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "What is new when an earlier impression reads similarly",
        "title": "Delta"
      },
      "image_path": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Workspace-relative image",
        "title": "Image Path"
      },
      "source_event_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "event_id of the vision tool event or image observation",
        "title": "Source Event Id"
      },
      "model": {
        "minLength": 1,
        "title": "Model",
        "type": "string"
      },
      "checklist": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "title": "Checklist",
        "type": "string"
      },
      "reviewer": {
        "default": "primary",
        "enum": [
          "primary",
          "blind",
          "tiebreak"
        ],
        "title": "Reviewer",
        "type": "string"
      },
      "findings": {
        "items": {
          "$ref": "#/$defs/VisionFinding"
        },
        "title": "Findings",
        "type": "array"
      },
      "lookback": {
        "items": {
          "$ref": "#/$defs/Lookback"
        },
        "title": "Lookback",
        "type": "array"
      }
    },
    "required": [
      "impression",
      "facets",
      "claims",
      "confidence",
      "model",
      "checklist",
      "lookback"
    ],
    "title": "VisionReviewInput",
    "type": "object"
  },
  "reconcile": {
    "additionalProperties": false,
    "properties": {
      "reviews": {
        "description": "event_ids of [primary, blind] or [primary, blind, tiebreak]",
        "items": {
          "type": "string"
        },
        "maxItems": 3,
        "minItems": 2,
        "title": "Reviews",
        "type": "array"
      }
    },
    "required": [
      "reviews"
    ],
    "title": "ReconcileInput",
    "type": "object"
  },
  "insight": {
    "$defs": {
      "EvidenceInput": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Workspace-relative file (hashed)",
            "title": "Path"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Standard, datasheet or law cited when there is no file",
            "title": "Reference"
          }
        },
        "title": "EvidenceInput",
        "type": "object"
      },
      "GateResult": {
        "additionalProperties": false,
        "properties": {
          "gate": {
            "minLength": 1,
            "title": "Gate",
            "type": "string"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "gate",
          "verdict"
        ],
        "title": "GateResult",
        "type": "object"
      },
      "InsightRef": {
        "additionalProperties": false,
        "properties": {
          "system": {
            "description": "Plugin that wrote the record",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "System",
            "type": "string"
          },
          "event_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Event Id",
            "type": "string"
          },
          "insight_id": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "Insight Id",
            "type": "string"
          }
        },
        "required": [
          "system",
          "event_id",
          "insight_id"
        ],
        "title": "InsightRef",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "insight": {
        "$ref": "#/$defs/InsightRef"
      },
      "status": {
        "enum": [
          "tried",
          "adopted",
          "rejected",
          "deferred",
          "superseded"
        ],
        "title": "Status",
        "type": "string"
      },
      "reason": {
        "minLength": 40,
        "title": "Reason",
        "type": "string"
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/EvidenceInput"
        },
        "minItems": 1,
        "title": "Evidence",
        "type": "array"
      },
      "gate_verdicts": {
        "items": {
          "$ref": "#/$defs/GateResult"
        },
        "title": "Gate Verdicts",
        "type": "array"
      },
      "decision_refs": {
        "items": {
          "type": "string"
        },
        "title": "Decision Refs",
        "type": "array"
      },
      "revisit_when": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Revisit When"
      }
    },
    "required": [
      "insight",
      "status",
      "reason",
      "evidence"
    ],
    "title": "InsightStatusInput",
    "type": "object"
  },
  "song_receipt": {
    "additionalProperties": false,
    "properties": {
      "delivery": {
        "description": "liaison/<id>.bard-song.json addressed to this plugin",
        "title": "Delivery",
        "type": "string"
      },
      "felt": {
        "description": "What the song made you feel about the design (160+ chars)",
        "title": "Felt",
        "type": "string"
      },
      "prompted_review": {
        "title": "Prompted Review",
        "type": "boolean"
      },
      "follow_up": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Follow Up"
      }
    },
    "required": [
      "delivery",
      "felt",
      "prompted_review"
    ],
    "title": "SongReceiptInput",
    "type": "object"
  },
  "read": {
    "additionalProperties": false,
    "properties": {
      "artifact": {
        "description": "Workspace-relative sister artifact you took in",
        "title": "Artifact",
        "type": "string"
      },
      "producer": {
        "description": "Plugin that produced it",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "title": "Producer",
        "type": "string"
      }
    },
    "required": [
      "artifact",
      "producer"
    ],
    "title": "ReadInput",
    "type": "object"
  }
}
